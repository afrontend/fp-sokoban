{
  "name": "fp-sokoban",
  "version": "0.0.1",
  "description": "functional Sokoban game library and terminal game",
  "homepage": "https://github.com/afrontend/fp-sokoban",
  "author": {
    "name": "afrontend",
    "email": "autoscripts@gmail.com",
    "url": "https://afrontend.github.io"
  },
  "files": [
    "lib",
    "src",
    "!**/__tests__"
  ],
  "main": "lib/index.js",
  "bin": {
    "fp-sokoban": "src/example.js"
  },
  "keywords": [
    "javascript",
    "sokoban",
    "game",
    "functional-programming"
  ],
  "scripts": {
    "pretest": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node ./src/example.js",
    "generate": "node ./src/generate.js",
    "add-level": "node ./src/append.js --count 1",
    "levels:append": "node ./src/append.js",
    "demo-gif": "bash scripts/make-demo.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afrontend/fp-sokoban.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fp-panel": "^0.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.0.0",
    "vitest": "^4.1.7"
  }
}
